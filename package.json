{
  "name": "@draftbase/sdk",
  "version": "0.0.0",
  "description": "Node.js / Next.js client for fetching content from Draftbase",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "draftbase-sync": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "lint": "tsc --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "devDependencies": {
    "@draftbase/tsconfig": "workspace:*",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.0"
  }
}
